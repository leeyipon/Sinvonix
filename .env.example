# Copy to .env.local for local development, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.

# --- Database (required) -----------------------------------------------------
# PostgreSQL. On Vercel, use a Neon / Vercel Postgres database.
#
# DATABASE_URL  — pooled connection, used by the app at runtime (serverless).
#                 For Neon this is the "-pooler" host with ?sslmode=require.
# DIRECT_URL    — direct (non-pooled) connection, used by `prisma migrate`
#                 during the build. Falls back to DATABASE_URL if unset, but a
#                 direct connection is recommended for migrations.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.REGION.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.REGION.aws.neon.tech/dbname?sslmode=require"

# --- Email notifications (optional) ------------------------------------------
# Resend API key. If unset, form submissions still save but no email is sent.
RESEND_API_KEY=""
# Where lead/booking/application notifications are emailed.
LEAD_NOTIFY_EMAIL="leeyipon02@gmail.com"

# --- Telegram alerts (optional) ----------------------------------------------
# If either is unset, Telegram alerts are skipped.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
